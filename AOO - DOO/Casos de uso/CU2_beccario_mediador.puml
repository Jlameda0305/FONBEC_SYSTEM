@startuml
left to right direction
skinparam actorStyle awesome

' Definición de actores
:Becario: as b

package "Sistema de Gestión de Becas" {
    
    usecase "Contactar al mediador" as CU_Contactar
    usecase "Seleccionar mediador" as CU_Select
    usecase "Generar vínculo de contacto" as CU_Vinculo
    
    ' Flujos alternativos (extensiones) convertidos en acciones
    usecase "Error: sin mediador asignado" as Ext_NoMediador
    usecase "Error: sin número" as Ext_NoNum
}

' Relaciones del Becario (inicia la acción)
b --> CU_Contactar

' Lógica de Inclusión: Pasos obligatorios del flujo principal
CU_Contactar ..> CU_Select : <<include>>
CU_Contactar ..> CU_Vinculo : <<include>>

' Lógica de Extensión: Excepciones (flechas hacia el caso base con doble punto)
Ext_NoMediador ..> CU_Select : <<extend>>
Ext_NoNum ..> CU_Contactar : <<extend>>

@enduml