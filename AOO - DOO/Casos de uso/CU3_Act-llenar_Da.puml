@startuml
left to right direction
skinparam actorStyle awesome

:Becario: as b


package "Sistema de Gestión de Becas" {
    
    usecase "Solicitud de visualizacion de datos" as CU4_Solicitud
    usecase "Solicitud de llenado/actualización de datos académicos" as CU_Solicitud
    usecase "Comprobar estado" as ICU_ComprobarEstado

    usecase "Datos academicos ya fueron aprobados" as Ext_DatosAprobados

    usecase "Llenar/Actualizar datos académicos" as CU_Llenar
    usecase "Validar datos académicos" as Ext_Validar
    usecase "Datos academicos actualizados" as Datos_Actualizados
}

b --> CU_Solicitud
CU_Solicitud .right.> ICU_ComprobarEstado : <<include>>
CU_Solicitud .right.> CU4_Solicitud : <<include>>

ICU_ComprobarEstado .right.> Ext_DatosAprobados : <<extend>>
CU_Solicitud ..> CU_Llenar : <<include>>
CU_Llenar .right.> Ext_Validar : <<include>>
CU_Llenar ..> Datos_Actualizados : <<extend>>

@enduml
