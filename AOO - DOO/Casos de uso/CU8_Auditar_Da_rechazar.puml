@startuml
left to right direction
skinparam actorStyle awesome

:Tutor: as t

package "Sistema de Gestión de Becas" {
    
    usecase "Rechazar datos académicos" as CU_Rechazar
    
    usecase "Seleccionar Becario" as ICU_Select
    usecase "Visualización de datos" as V_datos
    usecase "Validación de estado" as ICU_Validacion
    
    usecase "Registrar observaciones por rechazo" as CU_Observaciones
    usecase "Actualizar estado" as CU_Actualizar
}

' Relación Actor - Caso de Uso
t --> CU_Rechazar

' Dependencias (Includes) del Caso de Uso Principal
CU_Rechazar ..> ICU_Validacion : <<include>>
CU_Rechazar ..> V_datos : <<include>>
V_datos ..> ICU_Select : <<include>>

' Corrección de relaciones entre Casos de Uso
CU_Rechazar ..> CU_Observaciones : <<include>>
CU_Rechazar ..> CU_Actualizar : <<include>>

@enduml

