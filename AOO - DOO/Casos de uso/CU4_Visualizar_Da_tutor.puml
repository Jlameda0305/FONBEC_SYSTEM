@startuml
left to right direction
skinparam actorStyle awesome

' Definición de actores
:Becario: as b

package "Sistema de Gestión de Becas" {
    
    usecase "Solicitar visualización de datos" as CU_Solicitud
    usecase "Iniciar sesión" as l
    usecase "Registrarse" as r
    usecase "Visualizar datos" as V_datos
    usecase "Mostrar alerta de datos vacíos" as Ext_DatosVacios
}

' Relación del Actor con el caso de uso principal
b --> CU_Solicitud

' Includes: Pasos obligatorios tras solicitar la visualización
CU_Solicitud .right.> l : <<include>>
CU_Solicitud ..> V_datos : <<include>>

' Extend: Registrarse es opcional si el usuario no tiene cuenta al iniciar sesión
r .down.> l : <<extend>>

' Extend: Alerta condicional si la visualización arroja datos vacíos
Ext_DatosVacios .left.> V_datos : <<extend>>

' Nota aclaratoria
note right of V_datos
    Permite la visualización de:
    1. Estado de datos académicos
    2. Datos académicos
    3. Opción de llenado/actualización de formulario
end note

@enduml