@startuml
' ==========================================
' CONFIGURACIÓN VISUAL (ESTILO MODERNO - CLASES)
' ==========================================
skinparam roundcorner 10
skinparam shadowing true
skinparam nodesep 60
skinparam ranksep 70
skinparam defaultFontName "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif

' Estilo general de las flechas
skinparam arrow {
    Color #7F8C8D
    Thickness 1.5
}

' Estilo base para todos los estados
skinparam state {
    BackgroundColor White
    BorderColor #BDC3C7
    FontColor #2C3E50
    FontSize 14
    AttributeFontSize 12
}

' ==========================================
' PALETA DE COLORES SEMÁNTICA
' ==========================================
skinparam state<<Vacio>> {
    BackgroundColor #F2F4F4
    BorderColor #95A5A6
}

skinparam state<<Incompleto>> {
    BackgroundColor #FCF3CF
    BorderColor #F1C40F
}

skinparam state<<Revision>> {
    BackgroundColor #D4E6F1
    BorderColor #3498DB
}

skinparam state<<Modificar>> {
    BackgroundColor #FDEBD0
    BorderColor #E67E22
}

skinparam state<<Aprobado>> {
    BackgroundColor #D5F5E3
    BorderColor #2ECC71
}

' ==========================================
' LEYENDA (NOTAS SEPARADAS)
' ==========================================
legend top left
  **Notas y Reglas de Negocio:**
  
  <color:#F1C40F>■</color> **Incompleto:** Faltan campos obligatorios.
  <color:#3498DB>■</color> **En Revisión:** Listo para auditoría del Tutor.
  <color:#E67E22>■</color> **A Modificar:** Rechazado con observaciones.
  
  * **RN-02:** Una vez que los datos alcanzan el estado 
    **Aprobado**, no pueden volver a ser modificados 
    por el becario.
  * El sistema evalúa automáticamente la función 
    **[validar_completitud()]** en cada guardado.

    **Extencion de la leyenda:**
    Guardar avance\n Guardar datos sin completar = [validar_completitud() == false]
    Guardar datos y marcar para revisión = [validar_completitud() == true]
    Rechazar datos y agregar comentarios = [Tutor agrega observaciones]
    Aprobar datos tras revisión = [Tutor verifica validez]
    Guardar datos corregidos y marcar para revisión = [validar_completitud() == true]
end legend

' ==========================================
' DEFINICIÓN DE ESTADOS
' ==========================================
state "Vacio" as Vacio <<Vacio>>
state "Incompleto" as Incompleto <<Incompleto>>
state "Pendiente_Revision" as Pendiente_Revision <<Revision>>
state "Pendiente_Modificar" as Pendiente_Modificar <<Modificar>>
state "Aprobado" as Aprobado <<Aprobado>>

' ==========================================
' TRANSICIONES Y FLUJO
' ==========================================

' Inicio del ciclo de vida
[*] -down-> Vacio : Creación del perfil

' Acciones del Becario (CU-03)
Vacio ---> Incompleto : Guardar datos sin completar
Vacio ---> Pendiente_Revision : Guardar datos y marcar para revisión

Incompleto --> Incompleto : Guardar datos sin completar
Incompleto --> Pendiente_Revision : Guardar datos y marcar para revisión

' Acciones del Tutor (CU-08)
Pendiente_Revision --> Pendiente_Modificar : Rechazar datos y agregar comentarios
Pendiente_Revision ---> Aprobado : Aprobar datos tras revisión  

' Acciones del Becario tras un rechazo
Pendiente_Modificar --> Incompleto : Guardar datos sin completar
Pendiente_Modificar --> Pendiente_Revision : Guardar datos corregidos y marcar para revisión

' Fin del ciclo
Aprobado -down-> [*] : Cierre del ciclo

@enduml