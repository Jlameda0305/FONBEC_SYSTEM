@startuml
left to right direction
' ==========================================
' CONFIGURACIÓN VISUAL Y ESTÉTICA (MODERNA)
' ==========================================
skinparam roundcorner 10
skinparam shadowing true
skinparam nodesep 60
skinparam ranksep 70
skinparam defaultFontName "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif

' Estilo general de las flechas
skinparam arrow {
    Color #7F8C8D
    Thickness 1.5
}

' Estilos base para todas las clases
skinparam class {
    BackgroundColor White
    BorderColor #BDC3C7
    ArrowColor #7F8C8D
    HeaderBackgroundColor #ECF0F1
    FontColor #2C3E50
    FontSize 14
    AttributeFontSize 12
}

' Estilos de Enums
skinparam enum {
    BackgroundColor White
    BorderColor #9B59B6
    HeaderBackgroundColor #F4ECF7
    FontColor #2C3E50
}

' ==========================================
' PALETA DE COLORES POR ESTEREOTIPO
' ==========================================
skinparam class<<Aggregate Root>> {
    HeaderBackgroundColor #FCF3CF
    BorderColor #F1C40F
}

skinparam class<<Abstracta>> {
    HeaderBackgroundColor #EAEDED
    BorderColor #95A5A6
    FontShape italic
}

skinparam class<<Referente>> {
    HeaderBackgroundColor #D5F5E3
    BorderColor #2ECC71
}

skinparam class<<Dominio>> {
    HeaderBackgroundColor #FDEBD0
    BorderColor #E67E22
}

' ==========================================
' ENUMS DE DOMINIO
' ==========================================

enum NivelCursado {
  Primario
  Secundario
  Terciario
  Universitario
}

enum EstadoVerificacion {
  Vacio
  Incompleto
  Pendiente_Revision
  Pendiente_Modificar
  Aprobado
}

enum EstadoTutoria {
  Programada
  Realizada
  Ausente
  Cancelada
}

enum EstadoEnvioCarta {
  Programada
  Reprogramada
  Cancelada
  Enviada
}
' ==========================================
' CLASES DEL SISTEMA
' ==========================================

abstract class Usuario <<Abstracta>> {
  - id_usuario
  - nombre
  - apellido
  - email
  - telefono
  - edad
  - sexo
  - direccion
  - password_hash
  - rol
  + login()
  + logout()
  + actualizar_datos_personales()
  + restablecer_contrasena()
  + {abstract} visualizar_datos_academicos()
}

abstract class Referente <<Abstracta>> {
  - lista_becarios : List<Becario>
  + listar_becarios_asignados()
  + {abstract} seleccionar_becario()
  + {abstract} visualizar_datos_academicos()
}

class Becario <<Aggregate Root>> {
  - rol = "becario"
  - nivel_cursado : NivelCursado
  - datos_academicos : DatosAcademicos
  - puntero_tutor : Tutor
  - puntero_mediador : Mediador
  - puntero_padrino : Padrino
  - lista_tutorias : List<Tutoria>
  - lista_envios_cartas : List<EnvioCarta>
  + visualizar_datos_academicos()
  + visualizar_formulario_academico()
  + llenar_actualizar_formulario_academico()
  + ver_calendario_tutorias()
  + ver_calendario_envio()
  + get_datos_contacto()
  + contacto_mediador()
  + contacto_tutor()
}

class Tutor <<Referente>> {
  - rol = "tutor"
  + seleccionar_becario()
  + visualizar_datos_academicos()
  + auditar_datos_academicos_becario()
  + visualizar_calendario_tutoria()
  + crear_tutoria()
  + actualizar_tutoria()
  + eliminar_tutoria()
  + contactar_mediador_becario()
  + get_datos_contacto()
}

class Mediador <<Referente>> {
  - rol = "mediador"
  + seleccionar_becario()
  + visualizar_datos_academicos()
  + ver_calendario_envio_cartas()
  + crear_envio_carta()
  + actualizar_envio_carta()
  + contactar_tutor_becario()
  + get_datos_contacto()
}

class Padrino <<Dominio>> {
  - id_padrino
  - nombre
  - apellido
  - email
  - telefono
  - direccion
}

class DatosAcademicos <<Dominio>> {
  - nombre_carrera
  - anio_ingreso
  - anio_en_curso
  - materias_a_cursar : List
  - materias_adeudadas : List
  - lista_documentos : List<DocumentoAcademico>
  - estado_verificacion : EstadoVerificacion
  + actualizar_estado(nuevo_estado)
  + validar_completitud()
  + actualizar_datos()
}

class DocumentoAcademico <<Dominio>> {
  - tipo_documento
  - ruta_archivo
  - fecha_carga
}

class Tutoria <<Dominio>> {
  - id_tutoria
  - fecha_hora
  - estado : EstadoTutoria
  + cambiar_estado(nuevo_estado)
  + reprogramar(nueva_fecha_hora)
}

class EnvioCarta <<Dominio>> {
  - id_envio
  - fecha_envio
  - estado : EstadoEnvioCarta
  + actualizar_estado_envio(nuevo_estado)
  + actualizar_fecha_envio(nueva_fecha)
}

' ==========================================
' RELACIONES DE HERENCIA
' ==========================================
Usuario <|-- Becario
Usuario <|-- Referente
Referente <|-- Tutor
Referente <|-- Mediador

' ==========================================
' ASOCIACIONES Y COMPOSICIONES
' ==========================================

' Composiciones directas (El rombo negro va del lado del contenedor)
Becario *-- "1" DatosAcademicos : contiene >
DatosAcademicos *-- "*" DocumentoAcademico : adjunta >

' Colecciones
Becario "1" -left-> "*" Tutoria : gestiona >
Becario "1" -left-> "*" EnvioCarta : gestiona >

' Punteros relacionales
Becario "1" -right-> "1" Padrino : asignado a >
Becario "1" -right-> "1" Tutor : asignado a >
Becario "1" -right-> "1" Mediador : asignado a >


' Relación del Referente
Referente "1" --> "*" Becario : supervisa >

' Lineas ocultas para organizacion
Tutor -[hidden]right- Mediador
Becario -[hidden]up- Usuario

Usuario -[hidden]left- NivelCursado
EstadoVerificacion -[hidden]up- NivelCursado
EstadoTutoria -[hidden]right- NivelCursado
EstadoVerificacion -[hidden]left- EstadoEnvioCarta
EstadoTutoria -[hidden]- EstadoEnvioCarta

Referente -[hidden]-- Padrino

@enduml